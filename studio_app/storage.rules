rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if file is an image
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Helper function to check file size (max 10MB)
    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // User avatars
    match /avatars/{userId}/{fileName} {
      // Anyone can read avatars
      allow read: if true;

      // Only the user can list their own avatars (for deletion/replacement)
      allow list: if isAuthenticated() && request.auth.uid == userId;

      // Only the user can upload/update their own avatar
      allow create, update: if isAuthenticated()
                            && request.auth.uid == userId
                            && isImage()
                            && isValidSize();

      // Only the user can delete their own avatar
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Recipe images (covers and step photos)
    match /recipes/{recipeId}/{fileName} {
      // Anyone can read recipe images
      allow read: if true;

      // Authenticated users can list recipe images (for deletion)
      allow list: if isAuthenticated();

      // Only authenticated users can upload recipe images
      allow create, update: if isAuthenticated()
                            && isImage()
                            && isValidSize();

      // Only authenticated users can delete recipe images
      // (In production, add authorId check via Firestore lookup)
      allow delete: if isAuthenticated();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
